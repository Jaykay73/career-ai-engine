# Environment Configuration
APP_ENV=development
LOG_LEVEL=INFO

# LLM Provider Configuration
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# Embedding Model Configuration (Local SentenceTransformers)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Vector Store (Qdrant)
# By default, local embedded disk mode is used (no Docker or remote server needed)
QDRANT_STORAGE_PATH=./data/qdrant_db
QDRANT_COLLECTION=career_knowledge
# Set QDRANT_HOST and QDRANT_PORT if using remote/docker Qdrant
# QDRANT_HOST=localhost
# QDRANT_PORT=6333

# Reciprocal Rank Fusion (RRF) Parameters
RRF_K=60
TOP_K_BM25=20
TOP_K_VECTOR=20
TOP_K_RRF=12

# Storage and Directories
DATA_DIR=./data
OUTPUT_DIR=./output
KNOWLEDGE_DIR=./knowledge
TEMPLATES_DIR=./templates

# LaTeX Compiler Settings
LATEX_ENABLED=true
LATEX_COMPILER=pdflatex
LATEX_TIMEOUT_SECONDS=30
